# SLA Planner — Backend Configuration

# App
APP_NAME=SLA Planner
APP_VERSION=0.1.0
DEBUG=false

# Database
# SQLite (dev/test):
DATABASE_URL=sqlite+aiosqlite:///./sla_planner.db
# PostgreSQL (prod):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sla_planner

# JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Zabbix
ZABBIX_API_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_API_TOKEN=your-zabbix-api-token-here
ZABBIX_READ_ONLY=true

# Timezone
DEFAULT_TIMEZONE=Europe/Moscow
