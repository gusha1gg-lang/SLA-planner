# SLA Planner — Docker Environment
# Copy to .env and fill in real values

# JWT Secret (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Zabbix Connection
ZABBIX_API_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_API_TOKEN=your-zabbix-api-token-here

# Safety: set to false only when you're ready to write to Zabbix
ZABBIX_READ_ONLY=true
